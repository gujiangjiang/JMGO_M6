<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/entry_toolbox"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tbDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tbState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/teal"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_entry"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tb_brightness"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tbBrightValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="15sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/tbBright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowShot"
            style="@style/SettingRow"
            android:layout_marginTop="10dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cast" />

            <LinearLayout style="@style/SettingRowTexts">

                <TextView
                    style="@style/SettingRowTitle"
                    android:text="@string/tb_screenshot" />

                <TextView
                    style="@style/SettingRowSub"
                    android:text="@string/tb_screenshot_sub" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowInstall"
            style="@style/SettingRow"
            android:layout_marginTop="8dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_agent" />

            <LinearLayout style="@style/SettingRowTexts">

                <TextView
                    style="@style/SettingRowTitle"
                    android:text="@string/tb_install" />

                <TextView
                    style="@style/SettingRowSub"
                    android:text="@string/tb_install_sub" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowPkgReset"
            style="@style/SettingRow"
            android:layout_marginTop="8dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings" />

            <LinearLayout style="@style/SettingRowTexts">

                <TextView
                    style="@style/SettingRowTitle"
                    android:text="@string/tb_pkgreset" />

                <TextView
                    style="@style/SettingRowSub"
                    android:text="@string/tb_pkgreset_sub" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowFiles"
            style="@style/SettingRow"
            android:layout_marginTop="8dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_toolbox" />

            <LinearLayout style="@style/SettingRowTexts">

                <TextView
                    style="@style/SettingRowTitle"
                    android:text="@string/tb_files" />

                <TextView
                    style="@style/SettingRowSub"
                    android:text="@string/tb_files_sub" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tbStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
